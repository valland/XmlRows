{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XmlRows",
  "version": "0.1.2",
  "identifier": "no.braatetsoftware.xmlrows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XmlRows",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "xml",
          "xsd",
          "xsl",
          "xslt",
          "svg",
          "rss",
          "atom",
          "plist"
        ],
        "name": "XML Document",
        "role": "Editor"
      }
    ],
    "copyright": "Copyright © 2026 Bråtet Software AS",
    "resources": {
      "../LICENSE.txt": "legal/LICENSE.txt",
      "../legal/THIRD-PARTY-NOTICES.txt": "legal/THIRD-PARTY-NOTICES.txt"
    }
  }
}
